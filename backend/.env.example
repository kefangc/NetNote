# V1 can run without model credentials. These variables are reserved for the OpenAI-compatible adapter in V2.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CHAT_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=

# Optional V1 web-source search.
# Recommended for stable demos: run a self-hosted SearXNG instance and set its base URL.
# If omitted, the backend falls back to a lightweight DuckDuckGo HTML lookup and then demo data.
SEARXNG_BASE_URL=

# V2 storage target.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/software_cup_a3
